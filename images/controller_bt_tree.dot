digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
Root [fillcolor=cyan, fontcolor=black, fontsize=9, label=Root, shape=octagon, style=filled];
IPK_Mode [fillcolor=orange, fontcolor=black, fontsize=9, label=IPK_Mode, shape=box, style=filled];
Root -> IPK_Mode;
CheckIPK [fillcolor=gray, fontcolor=black, fontsize=9, label=CheckIPK, shape=ellipse, style=filled];
IPK_Mode -> CheckIPK;
IPK_Root [fillcolor=cyan, fontcolor=black, fontsize=9, label=IPK_Root, shape=octagon, style=filled];
IPK_Mode -> IPK_Root;
ProcessTarget [fillcolor=orange, fontcolor=black, fontsize=9, label=ProcessTarget, shape=box, style=filled];
IPK_Root -> ProcessTarget;
"HaveTarget?" [fillcolor=gray, fontcolor=black, fontsize=9, label="HaveTarget?", shape=ellipse, style=filled];
ProcessTarget -> "HaveTarget?";
"IsNotSingularity?" [fillcolor=gray, fontcolor=black, fontsize=9, label="IsNotSingularity?", shape=ellipse, style=filled];
ProcessTarget -> "IsNotSingularity?";
MoveToTarget [fillcolor=gray, fontcolor=black, fontsize=9, label=MoveToTarget, shape=ellipse, style=filled];
ProcessTarget -> MoveToTarget;
WaitForTarget [fillcolor=gray, fontcolor=black, fontsize=9, label=WaitForTarget, shape=ellipse, style=filled];
IPK_Root -> WaitForTarget;
TO_Mode [fillcolor=orange, fontcolor=black, fontsize=9, label=TO_Mode, shape=box, style=filled];
Root -> TO_Mode;
CheckTO [fillcolor=gray, fontcolor=black, fontsize=9, label=CheckTO, shape=ellipse, style=filled];
TO_Mode -> CheckTO;
TO_Root [fillcolor=orange, fontcolor=black, fontsize=9, label=TO_Root, shape=box, style=filled];
TO_Mode -> TO_Root;
GetTeleopFrame [fillcolor=gray, fontcolor=black, fontsize=9, label=GetTeleopFrame, shape=ellipse, style=filled];
TO_Root -> GetTeleopFrame;
ChooseFrame [fillcolor=cyan, fontcolor=black, fontsize=9, label=ChooseFrame, shape=octagon, style=filled];
TO_Root -> ChooseFrame;
ToolframeBranch [fillcolor=orange, fontcolor=black, fontsize=9, label=ToolframeBranch, shape=box, style=filled];
ChooseFrame -> ToolframeBranch;
CheckToolFrame [fillcolor=gray, fontcolor=black, fontsize=9, label=CheckToolFrame, shape=ellipse, style=filled];
ToolframeBranch -> CheckToolFrame;
ToolframeMode [fillcolor=gray, fontcolor=black, fontsize=9, label=ToolframeMode, shape=ellipse, style=filled];
ToolframeBranch -> ToolframeMode;
WorldframeBranch [fillcolor=orange, fontcolor=black, fontsize=9, label=WorldframeBranch, shape=box, style=filled];
ChooseFrame -> WorldframeBranch;
CheckWorldFrame [fillcolor=gray, fontcolor=black, fontsize=9, label=CheckWorldFrame, shape=ellipse, style=filled];
WorldframeBranch -> CheckWorldFrame;
WorldframeMode [fillcolor=gray, fontcolor=black, fontsize=9, label=WorldframeMode, shape=ellipse, style=filled];
WorldframeBranch -> WorldframeMode;
AM_Mode [fillcolor=orange, fontcolor=black, fontsize=9, label=AM_Mode, shape=box, style=filled];
Root -> AM_Mode;
CheckAM [fillcolor=gray, fontcolor=black, fontsize=9, label=CheckAM, shape=ellipse, style=filled];
AM_Mode -> CheckAM;
AM_Root [fillcolor=cyan, fontcolor=black, fontsize=9, label=AM_Root, shape=octagon, style=filled];
AM_Mode -> AM_Root;
"ProcessTarget*" [fillcolor=orange, fontcolor=black, fontsize=9, label="ProcessTarget*", shape=box, style=filled];
AM_Root -> "ProcessTarget*";
"HaveTarget?*" [fillcolor=gray, fontcolor=black, fontsize=9, label="HaveTarget?*", shape=ellipse, style=filled];
"ProcessTarget*" -> "HaveTarget?*";
IsNotSingularity [fillcolor=gray, fontcolor=black, fontsize=9, label=IsNotSingularity, shape=ellipse, style=filled];
"ProcessTarget*" -> IsNotSingularity;
"MoveToTarget*" [fillcolor=gray, fontcolor=black, fontsize=9, label="MoveToTarget*", shape=ellipse, style=filled];
"ProcessTarget*" -> "MoveToTarget*";
RequestTarget [fillcolor=gray, fontcolor=black, fontsize=9, label=RequestTarget, shape=ellipse, style=filled];
AM_Root -> RequestTarget;
}
