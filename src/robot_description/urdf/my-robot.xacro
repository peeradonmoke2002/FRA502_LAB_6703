<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">
    <xacro:property name="M_PI" value="3.14159"/>
   
    <link name="world"/>

    <joint name="joint_world" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="world"/>
        <child link="link_0"/>
    </joint>

    <link name="link_0">
        <visual>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://robot_description/meshes/link_0.stl" />
            </geometry>
        </visual>
    </link>

    <link name="link_1">
        <visual>
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://robot_description/meshes/link_1.stl" />
            </geometry>
        </visual>
    </link>

    <joint name="joint_1" type="revolute">
        <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0"/>
        <parent link="link_0"/>
        <child link="link_1"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="${-M_PI}" upper="${M_PI}" effort="1000.0" velocity="1000.0"/>
    </joint>

    <link name="link_2">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 ${-M_PI/2}"/> 
            <geometry>
                <mesh filename="package://robot_description/meshes/link_2.stl" />
            </geometry>
        </visual>
    </link>

    <joint name="joint_2" type="revolute">
        <origin xyz="0.0 -0.12 0.0" rpy="${-M_PI/2} 0 0"/> 
        <parent link="link_1"/>
        <child link="link_2"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="${-M_PI}" upper="${M_PI}" effort="1000.0" velocity="1000.0"/>
    </joint>

    <link name="link_3">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 ${-M_PI/2}"/> 
            <geometry>
                <mesh filename="package://robot_description/meshes/link_3.stl" />
            </geometry>
        </visual>
    </link>

    <joint name="joint_3" type="revolute">
        <origin xyz="0.0 -0.25 0.1" rpy="0 0 ${-M_PI/2}"/>
        <parent link="link_2"/>
        <child link="link_3"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="${-M_PI}" upper="${M_PI}" effort="1000.0" velocity="1000.0"/>
    </joint>

    <link name="end_effector">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/> 
            <geometry>
                <mesh filename="package://robot_description/meshes/end_effector.stl" />
            </geometry>
        </visual>
    </link>

    <joint name="joint_end_effector" type="fixed">
        <origin xyz="0.0 -0.28 0.0" rpy="${M_PI/2} 0 0"/> 
        <parent link="link_3"/>
        <child link="end_effector"/>
    </joint>

</robot>
