# RandomTarget.srv - Service for requesting random target in Auto Mode

# Request
bool request_new_target                # Request a new random target
bool target_reached                    # True when the controller reports the previous goal complete
geometry_msgs/Point current_position   # Current end-effector position (optional, used when reporting)

---

# Response
bool success                           # True if random target generated
geometry_msgs/Point target_position    # Random target position (x, y, z)
string message                         # Status or error message
